DATABASE_URL=postgresql+psycopg://brasil:brasil_local@localhost:5432/brasil_portodos
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
JWT_SECRET=
COOKIE_SECURE=false
ENVIRONMENT=development

# Assistência opcional. Nunca coloque a chave no frontend.
GEMINI_API_KEY=
GUIDANCE_AI_ENABLED=false
GUIDANCE_MODEL=gemini-3.5-flash-lite
GUIDANCE_DAILY_LIMIT=20
GUIDANCE_LOG_RETENTION_DAYS=7
GUIDANCE_TIMEOUT_SECONDS=30


# Agendamento nativo opcional; o Compose configura e executa o worker diário.
COLLECTION_SCHEDULE_ENABLED=false
COLLECTION_DAILY_AT=00:00
COLLECTION_TIMEZONE=America/Sao_Paulo
COLLECTION_RETRY_MINUTES=60
# Opcional. Vazio usa o primeiro ADMIN ativo só para atribuir a coleta.
COLLECTION_USERNAME=
